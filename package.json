{
  "name": "express-spring-security",
  "version": "1.0.0",
  "description": "Spring Security architecture for Express & TypeScript applications",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
