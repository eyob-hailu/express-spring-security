    "@vue/devtools-api": "^8.2.1",
    "@vue/shared": "^3.5.45",
    "@vueuse/core": "^15.0.0",
    "@vueuse/integrations": "^15.0.0",
    "focus-trap": "^7.8.0",
    "mark.js": "^8.11.1",
    "minisearch": "^7.2.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
